<Page
    x:Class="EPCalipersWinUI3.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EPCalipersWinUI3.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Flyout x:Key="unselectedColorPickerFlyout">
            <RelativePanel>
                <ColorPicker x:Name="unselectedColorPicker"
                         IsColorChannelTextInputVisible="False"
                             Color="{x:Bind ViewModel.UnselectedCaliperColor, Mode=TwoWay}"
                         IsHexInputVisible="False"/>
                <Grid RelativePanel.Below="unselectedColorPicker"
                  RelativePanel.AlignLeftWithPanel="True"
                  RelativePanel.AlignRightWithPanel="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button x:Uid="ButtonDone" Click="UnselectedColorButton_Click"
                        Margin="0,12,2,0" HorizontalAlignment="Stretch"
                            Grid.Column="1"/>
                </Grid>
            </RelativePanel>
        </Flyout>
        <Flyout x:Key="selectedColorPickerFlyout">
            <RelativePanel>
                <ColorPicker x:Name="selectedColorPicker" 
                         IsColorChannelTextInputVisible="False"
                             Color="{x:Bind ViewModel.SelectedCaliperColor, Mode=TwoWay}"
                         IsHexInputVisible="False"/>
                <Grid RelativePanel.Below="selectedColorPicker"
                  RelativePanel.AlignLeftWithPanel="True"
                  RelativePanel.AlignRightWithPanel="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button x:Uid="ButtonDone" Click="SelectedColorButton_Click"
                        Margin="0,12,2,0" HorizontalAlignment="Stretch"
                            Grid.Column="1"/>
                </Grid>
            </RelativePanel>
        </Flyout>
        <Flyout x:Key="fontColorPickerFlyout">
            <RelativePanel>
                <ColorPicker x:Name="fontColorPicker" 
                         IsColorChannelTextInputVisible="False"
                             Color="{x:Bind ViewModel.DefaultNoteForegroundColor, Mode=TwoWay}"
                         IsHexInputVisible="False"/>
                <Grid RelativePanel.Below="fontColorPicker"
                  RelativePanel.AlignLeftWithPanel="True"
                  RelativePanel.AlignRightWithPanel="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button x:Uid="ButtonDone" Click="fontColorPickerButton_Click"
                        Margin="0,12,2,0" HorizontalAlignment="Stretch"
                            Grid.Column="1"/>
                </Grid>
            </RelativePanel>
        </Flyout>
    </Page.Resources>

    <Grid x:Name="ContentArea" Margin="20" MinWidth="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Click="BackButton_Click" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <SymbolIcon>Back</SymbolIcon>
                <TextBlock Margin="10" x:Uid="ButtonBack" />
            </StackPanel>
        </Button>
        <TextBlock Grid.Row="0" x:Uid="SettingsTitle" Margin="10"
                   HorizontalAlignment="Center" Style="{StaticResource TitleLargeTextBlockStyle}" />
        <ScrollViewer Grid.Row="2" VerticalScrollMode="Enabled" Margin="10" HorizontalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Uid="StartupSettings" 
                           Margin="0,20,0,10" Style="{StaticResource SubtitleTextBlockStyle}"></TextBlock>
                <CheckBox x:Uid="ShowSampleEcgAtStartUp" IsChecked="{x:Bind ViewModel.ShowSampleEcgAtStartUp, Mode=TwoWay}" />
                <RadioButtons x:Name="CaliperViewOrientationRadioButtons" 
                              SelectedIndex="{x:Bind ViewModel.CaliperViewAlignment}"  
                          MaxColumns="2" Header="Image orientation"
                              SelectionChanged="CaliperViewOrientationRadioButtons_SelectionChanged" 
                              ItemsSource="{x:Bind ViewModel.ImagePositionItems}">
                </RadioButtons>
                <RadioButtons x:Name="StartupWindowRadioButtons" 
                              SelectedIndex="{x:Bind ViewModel.StartupPage}"  
                          MaxColumns="2" Header="Startup window"
                              SelectionChanged="StartupPageRadioButtons_SelectionChanged" 
                              ItemsSource="{x:Bind ViewModel.ViewItems}">
                </RadioButtons>
                <CheckBox x:Uid="IsAlwaysOnTop" IsChecked="{x:Bind ViewModel.IsAlwaysOnTop, Mode=TwoWay}" />
                <TextBlock x:Uid="LabelsSettings" Style="{StaticResource SubtitleTextBlockStyle}"
                           Margin="0,20,0,10"></TextBlock>
                <CheckBox x:Uid="Autoposition" IsChecked="{x:Bind ViewModel.AutoAlignLabel, Mode=TwoWay}" />
                <RadioButtons x:Name="TimeLabelRadioButtons" 
                              SelectedIndex="{x:Bind ViewModel.TimeCaliperLabelAlignment}"  
                          MaxColumns="4" Header="Time caliper label alignment" 
                          SelectionChanged="TimeLabelAlignment_SelectionChanged"
                              ItemsSource="{x:Bind ViewModel.Alignments}">
                </RadioButtons>
                <RadioButtons x:Name="AmplitudeLabelRadioButtons" 
                              SelectedIndex="{x:Bind ViewModel.AmplitudeCaliperLabelAlignment}"  
                          MaxColumns="4" Header="Amplitude caliper label position"
                          SelectionChanged="AmplitudeLabelAlignment_SelectionChanged"
                              ItemsSource="{x:Bind ViewModel.Alignments}">
                </RadioButtons>
                <TextBlock x:Uid="CalipersSettings" Style="{StaticResource SubtitleTextBlockStyle}"
                           Margin="0,20,0,10"></TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="unselectedColorPickerButton" x:Uid="SettingsUnselectedColor" Width="200"
                            Flyout="{StaticResource unselectedColorPickerFlyout}">
                    </Button>
                    <Rectangle Width="100" Height="20" HorizontalAlignment="Left" Margin="15,0,0,0">
                        <Rectangle.Fill>
                            <SolidColorBrush Color="{x:Bind ViewModel.UnselectedCaliperColor, Mode=OneWay}"/>
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="selectedColorPickerButton" x:Uid="SettingsSelectedColor" Width="200"
                            Flyout="{StaticResource selectedColorPickerFlyout}">
                    </Button>
                    <Rectangle Width="100" Height="20" HorizontalAlignment="Left" Margin="15,0,0,0">
                        <Rectangle.Fill>
                            <SolidColorBrush Color="{x:Bind ViewModel.SelectedCaliperColor, Mode=OneWay}"/>
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="thicknessSlider" Width="200" Minimum="1" Maximum="6" StepFrequency="1" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Margin="0,0,20,0"
                    Value="{x:Bind ViewModel.BarThickness, Mode=TwoWay}" TickFrequency="1" TickPlacement="Outside" />
                    <TextBlock VerticalAlignment="Center" x:Uid="CaliperLIneWidth"/>
                    <TextBlock Text="{x:Bind thicknessSlider.Value, Mode=OneWay}" VerticalAlignment="Center"/>
                </StackPanel>
                <RadioButtons x:Name="RoundingRadioButtons" 
                              SelectedIndex="{x:Bind ViewModel.Rounding}"  
                          MaxColumns="5" Header="Rounding"
                          SelectionChanged="Rounding_SelectionChanged"
                              ItemsSource="{x:Bind ViewModel.RoundingItems}">
                </RadioButtons>
                <!--<RadioButtons x:Name="CaliperLabelSizeRadioButtons" 
                              SelectedIndex="{x:Bind ViewModel.FontSize}"  
                          MaxColumns="5" Header="Caliper label size"
                          SelectionChanged="CaliperLabelSize_SelectionChanged"
                              ItemsSource="{x:Bind ViewModel.FontSizeItems}">
                </RadioButtons>-->
                    <NumberBox x:Uid="SettingsCaliperFontSize" Width="200"
                               HorizontalAlignment="Left"
               Value="{x:Bind ViewModel.FontSize, Mode=TwoWay}"
               Minimum="8"
               Maximum="48"
               SmallChange="1"
               SpinButtonPlacementMode="Inline" />
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="NumberOfMarchingCalipersSlider" Width="200" Minimum="1" Maximum="20" 
                        StepFrequency="1" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Margin="0,0,20,0"
                    Value="{x:Bind ViewModel.NumberOfMarchingCalipers, Mode=TwoWay}" TickFrequency="1" TickPlacement="Outside" />
                    <TextBlock VerticalAlignment="Center" x:Uid="NumberOfMarchingCalipers"/>
                    <TextBlock Text="{x:Bind NumberOfMarchingCalipersSlider.Value, Mode=OneWay}" VerticalAlignment="Center"/>
                </StackPanel>
                <CheckBox x:Uid="AllowNegativeCaliperValues" IsChecked="{x:Bind ViewModel.AllowNegativeCaliperValues, Mode=TwoWay}" />
                <TextBlock x:Uid="BrugadaTriangleSettings" 
                           Margin="0,20,0,10" Style="{StaticResource SubtitleTextBlockStyle}" ></TextBlock>
                <CheckBox x:Uid="ShowBrugadaTriangle" IsChecked="{x:Bind ViewModel.ShowBrugadaTriangle, Mode=TwoWay}" />
                <TextBlock x:Uid="ZoomSettings" 
                           Margin="0,20,0,10" Style="{StaticResource SubtitleTextBlockStyle}"></TextBlock>
                <CheckBox x:Uid="AdjustBarThicknessWithZoom" IsChecked="{x:Bind ViewModel.AdjustBarThicknessWithZoom, Mode=TwoWay}" />
                <CheckBox x:Uid="AdjustCaliperLabelSizeWithZoom" IsChecked="{x:Bind ViewModel.AdjustCaliperLabelSizeWithZoom, Mode=TwoWay}" />
                <TextBlock x:Uid="PDFSettings" Visibility="{x:Bind ViewModel.SupportsPdfs}"
                          Margin="0,20,0,10" Style="{StaticResource SubtitleTextBlockStyle}"></TextBlock>
                <RadioButtons x:Name="PdfResolutionRadioButtons" 
                            x:Uid="PDFResolution"
                            SelectedIndex="{x:Bind ViewModel.PdfResolution}"  
                            MaxColumns="2" 
                            SelectionChanged="PdfResolution_SelectionChanged"
                            ItemsSource="{x:Bind ViewModel.PdfResolutionItems}">
                </RadioButtons>
                <CheckBox x:Uid="RecalibrateBetweenPdfPages" 
                          Visibility="{x:Bind ViewModel.SupportsPdfs}"
                          IsChecked="{x:Bind ViewModel.RecalibrateBetweenPdfPages, Mode=TwoWay}" />
                <CheckBox x:Uid="ResetZoomBetweenPdfPages" 
                          Visibility="{x:Bind ViewModel.SupportsPdfs}"
                          IsChecked="{x:Bind ViewModel.ResetZoomBetweenPdfPages, Mode=TwoWay}" />
                <CheckBox x:Uid="ResetRotationBetweenPdfPages" 
                          Visibility="{x:Bind ViewModel.SupportsPdfs}"
                          IsChecked="{x:Bind ViewModel.ResetRotationBetweenPdfPages, Mode=TwoWay}" />
                <CheckBox x:Uid="ClearCalipersBetweenPdfPages" 
                          Visibility="{x:Bind ViewModel.SupportsPdfs}"
                          IsChecked="{x:Bind ViewModel.ClearCalipersBetweenPdfPages, Mode=TwoWay}" />
            <TextBlock Text="Notes"
           Style="{ThemeResource SubtitleTextBlockStyle}"
           Margin="0,24,0,12"/>

                <StackPanel Spacing="12">

                    <NumberBox x:Uid="SettingsNoteFontSize" Width="200"
                               HorizontalAlignment="Left"
               Value="{x:Bind ViewModel.DefaultNoteFontSize, Mode=TwoWay}"
               Minimum="8"
               Maximum="48"
               SmallChange="1"
               SpinButtonPlacementMode="Inline" />

                    <NumberBox x:Uid="SettingsNoteWidth" Width="200"
                               HorizontalAlignment="Left"
               Value="{x:Bind ViewModel.DefaultNoteWidth, Mode=TwoWay}"
               Minimum="60"
               Maximum="600"
               SmallChange="10"
               SpinButtonPlacementMode="Inline" />

                    <NumberBox x:Uid="SettingsNoteHeight" Width="200"
                               HorizontalAlignment="Left"


               Value="{x:Bind ViewModel.DefaultNoteHeight, Mode=TwoWay}"
               Minimum="30"
               Maximum="400"
               SmallChange="10"
               SpinButtonPlacementMode="Inline" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="fontColorPickerButton" x:Uid="SettingsFontColor" Width="200"
                            Flyout="{StaticResource fontColorPickerFlyout}">
                        </Button>
                        <Rectangle Width="100" Height="20" HorizontalAlignment="Left" Margin="15,0,0,0">
                            <Rectangle.Fill>
                                <SolidColorBrush Color="{x:Bind ViewModel.DefaultNoteForegroundColor, Mode=OneWay}"/>
                            </Rectangle.Fill>
                        </Rectangle>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
