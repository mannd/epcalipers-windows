<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EPCalipersWinUI3.Views.TransparentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EPCalipersWinUI3.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="mainPage"
    NavigationCacheMode="Required"
    Background="Transparent">
    <Page.Resources>
        <MenuFlyout x:Key="ContextMenuFlyout">
            <MenuFlyoutItem x:Uid="SelectComponentMenuItem" 
                IsEnabled="{x:Bind ViewModel.IsNearCaliper, Mode=OneWay}"
                            Tag="red" Click="SelectComponent_Click"/>
            <MenuFlyoutItem x:Uid="SelectCaliperMenuItem" Tag="green" Click="SelectCaliper_Click"
                IsEnabled="{x:Bind ViewModel.IsNearCaliper, Mode=OneWay}"/>
            <MenuFlyoutItem x:Uid="DeleteCaliperMenuItem" Tag="green" Click="DeleteCaliper_Click"
                IsEnabled="{x:Bind ViewModel.IsNearCaliper, Mode=OneWay}"/>
            <MenuFlyoutItem x:Uid="ColorMenuItem" Tag="green" Click="ColorCaliper_Click"
                IsEnabled="{x:Bind ViewModel.IsNearCaliper, Mode=OneWay}"/>
            <ToggleMenuFlyoutItem x:Uid="MarchingMenuItem" Tag="green" Click="MarchingCaliper_Click"
                IsChecked="{x:Bind ViewModel.CaliperIsMarching, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.IsNearCaliper, Mode=OneWay}"/>
        </MenuFlyout>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <MenuBar Grid.Row="0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <MenuBarItem x:Uid="FileMenu">
                <MenuFlyoutItem x:Uid="ExitMenuItem" Command="{x:Bind ViewModel.ExitCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F4" Modifiers="Menu"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem x:Uid="ViewMenu">
                <MenuFlyoutItem x:Uid="MainMenuItem" Command="{x:Bind ViewModel.ToggleTransparentWindowCommand}">
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="TransparentMenuItem"></MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem x:Uid="CalipersMenu">
                <MenuFlyoutItem x:Uid="TimeCaliperMenuItem" 
                                Command="{x:Bind ViewModel.AddTimeCaliperCommand}">
                    <MenuFlyoutItem.Icon>
                        <BitmapIcon UriSource="Assets/TimeCaliper.scale-200.png" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="T" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="AmplitudeCaliperMenuItem" 
                                Command="{x:Bind ViewModel.AddAmplitudeCaliperCommand}">
                    <MenuFlyoutItem.Icon>
                        <BitmapIcon UriSource="Assets/AmplitudeCaliper.scale-200.png" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="A" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="AngleCaliperMenuItem"
                                Command="{x:Bind ViewModel.AddAngleCaliperCommand}">
                    <MenuFlyoutItem.Icon>
                        <BitmapIcon UriSource="Assets/AngleCaliper.scale-200.png" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="G" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Uid="DeleteCaliperMenuItem" IsEnabled="{x:Bind ViewModel.ACaliperIsSelected, Mode=OneWay}"
                    Command="{x:Bind ViewModel.DeleteSelectedCaliperCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Icon="Delete" x:Uid="DeleteAllCalipersMenuItem" 
                                IsEnabled="{x:Bind ViewModel.HasCalipers, Mode=OneWay}"
                                Command="{x:Bind ViewModel.DeleteAllCalipersCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete" Modifiers="Shift"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Icon="Clear" x:Uid="UnselectAllCalipersMenuItem" 
                                IsEnabled="{x:Bind ViewModel.ACaliperIsSelected, Mode=OneWay}"
                                Command="{x:Bind ViewModel.UnselectAllCalipersCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Uid="SetCalibrationMenuItem" 
                                Command="{x:Bind ViewModel.SetCalibrationCommand}" />
                <MenuFlyoutItem x:Uid="ClearCalibrationMenuItem" IsEnabled="{x:Bind ViewModel.IsCalibrated, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ClearCalibrationCommand}"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Uid="MoveLeftMenuItem"
                                IsEnabled="{x:Bind ViewModel.ACaliperIsSelected, Mode=OneWay}"
                                Command="{x:Bind ViewModel.MoveLeftCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Left" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xF0B0;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="MoveRightMenuItem"
                                IsEnabled="{x:Bind ViewModel.ACaliperIsSelected, Mode=OneWay}"
                                Command="{x:Bind ViewModel.MoveRightCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Right" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xF0AF;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="MoveUpMenuItem"
                                IsEnabled="{x:Bind ViewModel.ACaliperIsSelected, Mode=OneWay}"
                                Command="{x:Bind ViewModel.MoveUpCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Up" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xF0AD;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="MoveDownMenuItem"
                                IsEnabled="{x:Bind ViewModel.ACaliperIsSelected, Mode=OneWay}"
                                Command="{x:Bind ViewModel.MoveDownCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Down" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xF0AE;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Uid="MicroMoveLeftMenuItem"
                                IsEnabled="{x:Bind ViewModel.ACaliperIsSelected, Mode=OneWay}"
                                Command="{x:Bind ViewModel.MicroMoveLeftCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Left" Modifiers="Control,Menu"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEC52;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="MicroMoveRightMenuItem"
                                IsEnabled="{x:Bind ViewModel.ACaliperIsSelected, Mode=OneWay}"
                                Command="{x:Bind ViewModel.MicroMoveRightCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Right" Modifiers="Control,Menu"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEBE7;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="MicroMoveUpMenuItem"
                                IsEnabled="{x:Bind ViewModel.ACaliperIsSelected, Mode=OneWay}"
                                Command="{x:Bind ViewModel.MicroMoveUpCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Up" Modifiers="Control,Menu"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE74A;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="MicroMoveDownMenuItem"
                                IsEnabled="{x:Bind ViewModel.ACaliperIsSelected, Mode=OneWay}"
                                Command="{x:Bind ViewModel.MicroMoveDownCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Down" Modifiers="Control,Menu"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE74B;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem x:Uid="ToolsMenu">
                <MenuFlyoutItem x:Uid="ToggleRateIntervalMenuItem" IsEnabled="{x:Bind ViewModel.IsTimeCalibrated, Mode=OneWay}" 
                                Command="{x:Bind ViewModel.ToggleRateIntervalCommand}" >
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="I" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="MeanRateIntervalMenuItem" IsEnabled="{x:Bind ViewModel.IsTimeCalibrated, Mode=OneWay}" 
                                Command="{x:Bind ViewModel.MeanRateIntervalCommand}"/>
                <MenuFlyoutItem x:Uid="MeasureQTcMenuItem" IsEnabled="{x:Bind ViewModel.IsTimeCalibrated, Mode=OneWay}" 
                                Command="{x:Bind ViewModel.MeasureQtcCommand}"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Uid="OptionsMenuItem" Command="{x:Bind ViewModel.ShowSettingsCommand}"> 
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE713;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem x:Uid="HelpMenu">
                <MenuFlyoutItem x:Uid="HelpMenuItem" Command="{x:Bind ViewModel.HelpCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F1"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Uid="AboutMenuItem" Click="About_Click"/>
            </MenuBarItem>
        </MenuBar>
        <CommandBar Grid.Row="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" 
                        IsOpen="False" DefaultLabelPosition="Right">
            <AppBarButton x:Uid="AddCaliperBarButton">
                <BitmapIcon UriSource="Assets/TimeCaliper.scale-200.png" 
                           ToolTipService.ToolTip="Add time caliper"/>
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Uid="TimeCaliperMenuItem" Command="{x:Bind ViewModel.AddTimeCaliperCommand}" >
                            <MenuFlyoutItem.Icon>
                                <BitmapIcon UriSource="Assets/TimeCaliper.scale-200.png" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="AmplitudeCaliperMenuItem" Command="{x:Bind ViewModel.AddAmplitudeCaliperCommand}">
                            <MenuFlyoutItem.Icon>
                                <BitmapIcon UriSource="Assets/AmplitudeCaliper.scale-200.png" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="AngleCaliperMenuItem" Command="{x:Bind ViewModel.AddAngleCaliperCommand}">
                            <MenuFlyoutItem.Icon>
                                <BitmapIcon UriSource="Assets/AngleCaliper.scale-200.png" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarSeparator/>
            <AppBarButton x:Uid="CalibrationBarButton">
                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE73E;" />
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Uid="SetCalibrationMenuItem" 
                                        Command="{x:Bind ViewModel.SetCalibrationCommand}" />
                        <MenuFlyoutItem x:Uid="ClearCalibrationMenuItem" 
                                        IsEnabled="{x:Bind ViewModel.IsCalibrated, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.ClearCalibrationCommand}"/>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Icon="Switch" x:Uid="RateIntervalBarButton" IsEnabled="{x:Bind ViewModel.IsTimeCalibrated, Mode=OneWay}" 
                                Command="{x:Bind ViewModel.ToggleRateIntervalCommand}" />
            <AppBarButton x:Uid="MeanRateIntervalBarButton" IsEnabled="{x:Bind ViewModel.IsTimeCalibrated, Mode=OneWay}" 
                                Command="{x:Bind ViewModel.MeanRateIntervalCommand}">
                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE94A;" />
            </AppBarButton>
            <AppBarButton Icon="Calculator" x:Uid="QTcBarButton" IsEnabled="{x:Bind ViewModel.IsTimeCalibrated, Mode=OneWay}" 
                          Command="{x:Bind ViewModel.MeasureQtcCommand}"/>
            <CommandBar.SecondaryCommands>
                <AppBarButton Icon="Setting" x:Uid="SettingsBarButton">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="I" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>
        <local:CaliperGrid x:Name="TransparentCaliperView" Grid.Row="2" Background="Transparent" 
                           PointerPressed="CaliperGrid_PointerPressed"
                          PointerMoved="CaliperGrider_PointerMoved" Tapped="CaliperGrider_Tapped"
                          RightTapped="CaliperGrid_RightTapped" ContextFlyout="{StaticResource ContextMenuFlyout}"
                          DoubleTapped="CaliperGrider_DoubleTapped" PointerReleased="CaliperGrid_PointerReleased"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        </local:CaliperGrid>
    </Grid>
</Page>
